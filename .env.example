# Twilio — voice call escalation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ElevenLabs — TTS for Twilio calls
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gmail — school email monitor
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ClassLink SSO — used by Canvas and Skyward scrapers
CLASSLINK_URL=
CLASSLINK_USER=
CLASSLINK_PASS=

# Public webhook (VPS) — Taegan's SMS replies cancel escalation timers, and
# Twilio fetches call audio from here. Point the Twilio number's
# "A message comes in" webhook at PUBLIC_BASE_URL/sms (HTTP POST).
PUBLIC_BASE_URL=http://179.236.242.215:8080
WEBHOOK_PORT=8080

# Telegram reminders — Taegan's routine messages go to Telegram instead of SMS.
# Use a SEPARATE reminder bot from @BotFather (not the Taegbot/OpenClaw bot).
# TELEGRAM_CHAT_ID is the Telegram user id of the account Taegan uses; that
# account must open the bot and tap Start once before it can receive messages.
# With these set, escalation calls go to parent_phone instead of taegan_phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
